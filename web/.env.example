# Public chain configuration. Defaults point to the deployed BOT testnet stack.
BOT_TESTNET_RPC=https://rpc.bohr.life
JOB_ESCROW_ADDRESS=0x627853Ddf094172913f23366839A86DF3d1Aa5bB
SELLER_BOND_ADDRESS=0x3A40b1dd835f271e2E67C5b2AEb82F27D4d5ec5D
IDENTITY_REGISTRY_ADDRESS=0x9e0F863AE8165688c6e5Ec335236bD459f2DdC8b
VALIDATION_REGISTRY_ADDRESS=0xA29b9F92Eb6A64B9371F86f80e458743341c6c9F

# Seller catalogue. Only agent 0 exists on the current deployment.
SELLER_HONEST_AGENT_ID=0
SELLER_FAULTY_AGENT_ID=
SELLER_ABSENT_AGENT_ID=

# Write mode is fail-closed. Keep false until persistence and wallets are configured.
DEMO_WRITE_ENABLED=false
BUYER_ADDRESS=
BUYER_PRIVATE_KEY=
SELLER_ADDRESS=
SELLER_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=
SESSION_SECRET=
DEMO_ACCESS_CODE=

# Optional BOT Chain EOA sponsor endpoint. Unset means self-paid.
PAYMASTER_RPC_URL=

# Required before DEMO_WRITE_ENABLED=true.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Hardened deployment only. The app refuses to write to the legacy contract addresses above.
ARBITER_ADDRESS=
ARBITER_PRIVATE_KEY=
