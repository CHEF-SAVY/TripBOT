# Public chain configuration. Defaults point to the hardened BOT testnet stack.
BOT_TESTNET_RPC=https://rpc.bohr.life
JOB_ESCROW_ADDRESS=0xe02695454edA18Ec0b00836F98635aC2D6CAA238
SELLER_BOND_ADDRESS=0x56641c18259bDf08dF4b78d14Bb7ECe3a2283A67
IDENTITY_REGISTRY_ADDRESS=0x66677c64d0545a5F161EAE83fed8D260EAc58cAa
VALIDATION_REGISTRY_ADDRESS=0x4Dd733cBAcF4A13bD265CCB17B026BD9CdDBb0B0

# Seller catalogue. Agents 0-2 are registered and bonded on the hardened deployment.
SELLER_HONEST_AGENT_ID=0
SELLER_FAULTY_AGENT_ID=1
SELLER_ABSENT_AGENT_ID=2

# Write mode is fail-closed. Keep false until persistence and wallets are configured.
DEMO_WRITE_ENABLED=false
BUYER_ADDRESS=
BUYER_PRIVATE_KEY=
SELLER_ADDRESS=
SELLER_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=
SESSION_SECRET=

# Optional BOT Chain EOA sponsor endpoint. Unset means self-paid.
PAYMASTER_RPC_URL=

# Required before DEMO_WRITE_ENABLED=true.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Arbiter is a third role, separate from both sides of any dispute it rules on.
# The app refuses to write to the superseded first deployment, whatever this is set to.
ARBITER_ADDRESS=
ARBITER_PRIVATE_KEY=
